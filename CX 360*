        if (manual ? showSRManual : isNear(dLowPrev))
            lbPDL := label.new(xl_pd, dLowPrev, "PDL", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=color.rgb(80,150,255), size=size.small)

    // CD levels — label only, no lines, no numbers
    if showPrevDay
        int xl_cd = x0 + puBars_PD + 2
        f_del_line(lCDO), lCDO := na, f_del_line(lCDH), lCDH := na, f_del_line(lCDL), lCDL := na
        f_del_label(lbCDO), lbCDO := na, f_del_label(lbCDH), lbCDH := na, f_del_label(lbCDL), lbCDL := na
        lbCDO := label.new(xl_cd, dOpenCurr, "CDO", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=color.rgb(0,130,180), size=size.small)
        lbCDH := label.new(xl_cd, dHighCurr, "CDH", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=color.rgb(0,160,100), size=size.small)
        lbCDL := label.new(xl_cd, dLowCurr,  "CDL", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=color.rgb(180,50,50), size=size.small)

    if showPivots
        int xl_pv = x0 + puBars_PD - 8
        // Clean old
        f_del_line(lP), lP := na, f_del_line(lR1), lR1 := na, f_del_line(lR2), lR2 := na, f_del_line(lR3), lR3 := na
        f_del_line(lS1), lS1 := na, f_del_line(lS2), lS2 := na, f_del_line(lS3), lS3 := na
