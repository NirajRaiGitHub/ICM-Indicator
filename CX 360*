            lbS3 := label.new(xl_pv, S3, "S3", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=color.rgb(20,80,45), size=size.small)
// O) VOLUME PROFILE
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
int vp_tf_ms = 1000 * timeframe.in_seconds()
int vp_lb_raw = vp_use_visible_range ?
     math.max(1, math.round((last_bar_time - chart.left_visible_bar_time) / vp_tf_ms)) :
     vp_lookback_depth
int vp_lb = math.max(1, math.min(vp_lb_raw, math.min(bar_index + 1, 4999)))

max_bars_back(high,   5000)
max_bars_back(low,    5000)
max_bars_back(close,  5000)
max_bars_back(open,   5000)
max_bars_back(volume, 5000)

float vp_hi       = ta.highest(vp_lb)
float vp_lo       = ta.lowest(vp_lb)
float vp_interval = vp_hi == vp_lo ? 1.0 : (vp_hi - vp_lo) / (vp_num_bars - 1)

var line  vp_poc_line = na
var line  vp_vah_line = na
var line  vp_val_line = na
var label vp_poc_lbl  = na
var label vp_vah_lbl  = na
var label vp_val_lbl  = na
var array<line> vp_bars = array.new_line()

if barstate.islast and not useBuiltinVP
    int _nc = array.size(vp_bars)
    if _nc > 0
        for _ci = 0 to _nc - 1
            line.delete(array.get(vp_bars, _ci))
        array.clear(vp_bars)
    if not na(vp_poc_line)
        line.delete(vp_poc_line), vp_poc_line := na
    if not na(vp_vah_line)
        line.delete(vp_vah_line), vp_vah_line := na
    if not na(vp_val_line)
        line.delete(vp_val_line), vp_val_line := na
    label.delete(vp_poc_lbl)
    label.delete(vp_vah_lbl)
    label.delete(vp_val_lbl)

vp_scale(float raw, float mx) =>
    float d = math.max(1e-10, mx) / math.max(1, vp_lb) / math.max(1e-10, vp_bar_len_mult / 100.0)
    math.max(1, math.round(raw / d))

vp_get_va(array<float> vols, int poc_idx, float poc_vol, float total_vol) =>
    float target = total_vol * vp_va_percent / 100.0
    int up_i = poc_idx, int dn_i = poc_idx
    float va_sum = poc_vol
    int n_bars = array.size(vols), int guard = 0
    while va_sum < target and guard < n_bars * 2
        float v_up = up_i < n_bars - 1 ? array.get(vols, up_i + 1) : 0.0
        float v_dn = dn_i > 0 ? array.get(vols, dn_i - 1) : 0.0
        if v_up == 0.0 and v_dn == 0.0
            break
        if v_up >= v_dn
            va_sum += v_up, up_i += 1
        else
            va_sum += v_dn, dn_i -= 1
        guard += 1
    [dn_i, up_i]

if barstate.islast and vp_show and useBuiltinVP
    int n         = vp_num_bars
    int cur_bars  = array.size(vp_bars)
    array<float> vols = array.new_float(n, 0.0)
    for i = 0 to vp_lb - 1
        bool is_bull = close[i] >= open[i]
        bool inc_vol = vp_volume_type == "Both" ? true : vp_volume_type == "Bullish" ? is_bull : not is_bull
        if inc_vol
            for j = 0 to n - 1
                float price_lvl = vp_lo + vp_interval * j
                if price_lvl >= low[i] and price_lvl < high[i]
                    array.set(vols, j, array.get(vols, j) + volume[i])
    float max_vol   = array.max(vols)
    int   poc_idx   = array.indexof(vols, max_vol)
    float total_vol = array.sum(vols)
    int   x_right   = bar_index + vp_right_offset
    if cur_bars != n
        if cur_bars > 0
            for _di = 0 to cur_bars - 1
                line.delete(array.get(vp_bars, _di))
        array.clear(vp_bars)
        for _ni = 0 to n - 1
            array.push(vp_bars, line.new(bar_index, close, bar_index, close, width=vp_bar_thickness))
        cur_bars := n
        if not na(vp_poc_line)
            line.delete(vp_poc_line)
        vp_poc_line := line.new(bar_index, close, bar_index, close, color=vp_poc_color, width=vp_poc_thickness)
        if vp_display_va and vp_display_va_lines
            if not na(vp_vah_line)
                line.delete(vp_vah_line)
            if not na(vp_val_line)
                line.delete(vp_val_line)
            vp_vah_line := line.new(bar_index, close, bar_index, close, color=vp_va_lines_color, width=vp_va_lines_thickness)
            vp_val_line := line.new(bar_index, close, bar_index, close, color=vp_va_lines_color, width=vp_va_lines_thickness)
    for i = 0 to n - 1
        float price_lvl = vp_lo + vp_interval * i
        int   scaled    = vp_scale(array.get(vols, i), max_vol)
        int   x1        = x_right - scaled
        color bar_col   = i == poc_idx ? vp_poc_color : vp_bar_color
        line.set_xy1(array.get(vp_bars, i), x1, price_lvl)
        line.set_xy2(array.get(vp_bars, i), x_right, price_lvl)
        line.set_color(array.get(vp_bars, i), bar_col)
        line.set_width(array.get(vp_bars, i), vp_bar_thickness)
    if vp_display_poc
        float poc_price = vp_lo + vp_interval * poc_idx
        int   poc_x1    = bar_index - vp_lb
        int   poc_x2    = x_right - vp_scale(max_vol, max_vol) - 5
        line.set_xy1(vp_poc_line, poc_x1, poc_price)
        line.set_xy2(vp_poc_line, poc_x2, poc_price)
        line.set_color(vp_poc_line, vp_poc_color)
        line.set_width(vp_poc_line, vp_poc_thickness)
        label.delete(vp_poc_lbl)
        if vp_show_poc_label
            int _rnd = syminfo.mintick <= 0.01 ? 2 : syminfo.mintick <= 0.1 ? 1 : 0
            vp_poc_lbl := label.new(poc_x1, poc_price, "PoC " + str.tostring(math.round(poc_price, _rnd)),
                 style=label.style_label_right, textcolor=vp_poc_color,
                 color=color.new(color.black,60), size=size.small)
    if vp_display_va and total_vol > 0
        [va_dn, va_up] = vp_get_va(vols, poc_idx, max_vol, total_vol)
        for i = va_dn to va_up
            if i != poc_idx
                line.set_color(array.get(vp_bars, i), vp_va_bar_color)
        if vp_display_va_lines
            float vah_price = vp_lo + vp_interval * va_up
            float val_price = vp_lo + vp_interval * va_dn
            int   va_x1     = bar_index - vp_lb
            line.set_xy1(vp_vah_line, va_x1, vah_price)
            line.set_xy2(vp_vah_line, x_right - vp_scale(array.get(vols, va_up), max_vol) - 5, vah_price)
            line.set_color(vp_vah_line, vp_va_lines_color)
            line.set_width(vp_vah_line, vp_va_lines_thickness)
            line.set_xy1(vp_val_line, va_x1, val_price)
            line.set_xy2(vp_val_line, x_right - vp_scale(array.get(vols, va_dn), max_vol) - 5, val_price)
            line.set_color(vp_val_line, vp_va_lines_color)
            line.set_width(vp_val_line, vp_va_lines_thickness)
            label.delete(vp_vah_lbl)
            label.delete(vp_val_lbl)
            if vp_show_va_labels
                int _rnd = syminfo.mintick <= 0.01 ? 2 : syminfo.mintick <= 0.1 ? 1 : 0
                vp_vah_lbl := label.new(va_x1, vah_price, "VAH " + str.tostring(math.round(vah_price, _rnd)),
                     style=label.style_label_right, textcolor=vp_va_lines_color,
                     color=color.new(color.black,60), size=size.small)
                vp_val_lbl := label.new(va_x1, val_price, "VAL " + str.tostring(math.round(val_price, _rnd)),
                     style=label.style_label_right, textcolor=vp_va_lines_color,
                     color=color.new(color.black,60), size=size.small)

