// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// WEIS WAVE INPUTS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TF DETECTION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
int  tf_secs       = timeframe.in_seconds()
bool tf_scalp      = tf_secs <= 900
bool tf_pattern_ok = tf_secs >= 300
bool show_bg       = showBgTint and tf_scalp

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// A) TIME / SESSIONS / NEWS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
string tz       = "GMT+5:30"
bool isIndia    = not na(time(timeframe.period, "0930-1130:1234567", tz))
bool isLondon   = not na(time(timeframe.period, "1330-1730:1234567", tz))
bool isUSKill   = not na(time(timeframe.period, "1830-2300:1234567", tz))
bool isTokyo    = not na(time(timeframe.period, "0530-1130:1234567", tz))
bool isShanghai = not na(time(timeframe.period, "0700-1230:1234567", tz))
bool isAsiaCore = isTokyo and isShanghai
bool isAvoid    = not na(time(timeframe.period, "1200-1330:1234567", tz)) or
                  not na(time(timeframe.period, "1730-1830:1234567", tz))

int nowMins = hour(timenow, tz) * 60 + minute(timenow, tz)
int nA = 19 * 60
int nB = 20 * 60 + 30
int dA = nA - nowMins
dA := dA <= 0 ? dA + 1440 : dA
int dB = nB - nowMins
dB := dB <= 0 ? dB + 1440 : dB

bool newsActive     = dA <= 30 or dB <= 30
int  newsMin        = math.min(dA, dB)

bool inTradeSession = isAsiaCore or isLondon or isUSKill or isShanghai
bool isHighVolSess  = isLondon or isUSKill
bool isMidVolSess   = isShanghai and not isAsiaCore  // Shanghai solo = valid but dampened

bool w_trade1 = not na(time(timeframe.period, "1830-1915:1234567", tz))
bool w_avoid  = not na(time(timeframe.period, "1930-2015:1234567", tz))
bool w_trade2 = not na(time(timeframe.period, "2030-2230:1234567", tz))
bool w_morn   = not na(time(timeframe.period, "0900-1030:1234567", tz))

string newsDisp =
     newsMin > 120 ? "OK" :
     newsMin > 60  ? str.tostring(math.round(newsMin / 60)) + "h" :
                     str.tostring(newsMin) + "m"

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// B) CORE INDICATORS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float atrV     = ta.atr(atr_len)
float rsiMain  = ta.rsi(close, rsi_len)
float volRatio = volume / ta.sma(volume, 20)
float vwapLine = ta.vwap(close)

[adxV, _diP, _diM] = ta.dmi(14, 14)  // diPlus/diMinus not used directly
bool   adxTrending = adxV > 20
bool   adxStrong   = adxV > 40
bool   adxRanging  = adxV < 15
string adxTxt      = adxStrong ? "STRONG" : adxTrending ? "TREND" : adxRanging ? "RANGE" : "WEAK"

float ema200m = ta.ema(close, 200)
float ema13   = ta.ema(close, 13)
float ema34   = ta.ema(close, 34)

float emaSeparation = math.abs(ema13 - ema34) / close * 100

// EMA slope — fast trend detection (catches trend before ADX)
float _emaSlope = (ema13 - ema13[3]) / atrV
bool _slopeBull = _emaSlope > 0.3
bool _slopeBear = _emaSlope < -0.3
bool _slopeTrending = _slopeBull or _slopeBear
bool  emasTrending  = emaSeparation >= ema_sep_min

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// D) HTF + MTF BIAS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[htfEma13, htfEma34, htfEma200] = request.security(syminfo.tickerid, htfTf,
     [ta.ema(close, 13), ta.ema(close, 34), ta.ema(close, 200)],
     lookahead=barmerge.lookahead_off)

bool   htfBull = htfEma13 > htfEma34 and htfEma34 > htfEma200
bool   htfBear = htfEma13 < htfEma34 and htfEma34 < htfEma200
bool   htfDN   = htfBear
float  _htfGap = math.abs(htfEma13 - htfEma34) / htfEma34 * 100
bool   htfTransUp = htfBear and _htfGap < 0.15
bool   htfTransDn = htfBull and _htfGap < 0.15
// HTF bias display — Weis momentum states (△UP/△DN) added after D2 section
string htfBias = htfBull ? (htfTransDn ? "HTF ⚠DN" : "HTF UP") : htfBear ? (htfTransUp ? "HTF ⚠UP" : "HTF DN") : "HTF RNG"
// ICM 1.6.1: Effective HTF — transition states act as partial bull/bear for zones & grades
bool _htfBullEff = (htfBull and not htfTransDn) or htfTransUp
bool _htfBearEff = (htfBear and not htfTransUp) or htfTransDn

float rsi5  = request.security(syminfo.tickerid, "5",   ta.rsi(close, rsi_len), lookahead=barmerge.lookahead_off)
float rsi15 = request.security(syminfo.tickerid, "15",  ta.rsi(close, rsi_len), lookahead=barmerge.lookahead_off)
float rsi1h = request.security(syminfo.tickerid, "60",  ta.rsi(close, rsi_len), lookahead=barmerge.lookahead_off)
float rsi4h = request.security(syminfo.tickerid, "240", ta.rsi(close, rsi_len), lookahead=barmerge.lookahead_off)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// D2) WEIS MULTI-TF VOLUME DOMINANCE
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[_wb1m,  _ws1m]  = request.security(syminfo.tickerid, "1",
     [ta.sma(volume * (close >= open ? 1.0 : 0.0), 8),
      ta.sma(volume * (close <  open ? 1.0 : 0.0), 8)], lookahead=barmerge.lookahead_off)
[_wb5m,  _ws5m]  = request.security(syminfo.tickerid, "5",
     [ta.sma(volume * (close >= open ? 1.0 : 0.0), 8),
      ta.sma(volume * (close <  open ? 1.0 : 0.0), 8)], lookahead=barmerge.lookahead_off)
[_wb15m, _ws15m] = request.security(syminfo.tickerid, "15",
     [ta.sma(volume * (close >= open ? 1.0 : 0.0), 8),
      ta.sma(volume * (close <  open ? 1.0 : 0.0), 8)], lookahead=barmerge.lookahead_off)
[_wb1h,  _ws1h]  = request.security(syminfo.tickerid, "60",
     [ta.sma(volume * (close >= open ? 1.0 : 0.0), 8),
      ta.sma(volume * (close <  open ? 1.0 : 0.0), 8)], lookahead=barmerge.lookahead_off)
[_wb4h,  _ws4h]  = request.security(syminfo.tickerid, "240",
     [ta.sma(volume * (close >= open ? 1.0 : 0.0), 8),
      ta.sma(volume * (close <  open ? 1.0 : 0.0), 8)], lookahead=barmerge.lookahead_off)

_wpct(float bv, float sv) =>
    float t = bv + sv
    t > 0 ? int(math.round(bv / t * 100)) : 50

int wbp1m  = _wpct(_wb1m,  _ws1m)
int wbp5m  = _wpct(_wb5m,  _ws5m)
int wbp15m = _wpct(_wb15m, _ws15m)
int wbp1h  = _wpct(_wb1h,  _ws1h)
int wbp4h  = _wpct(_wb4h,  _ws4h)

// CX 360 v3: Weis momentum override — bypass EMA alignment lag during strong moves
// Must be after wbp4h/wbp1h (D2) and ema13 (B) are declared
bool _weisMomBull = wbp4h > 70 and wbp1h > 60 and close > ema13 and adxV > 20
bool _weisMomBear = wbp4h < 30 and wbp1h < 40 and close < ema13 and adxV > 20
_htfBullEff := _htfBullEff or _weisMomBull
_htfBearEff := _htfBearEff or _weisMomBear
// Update HTF bias display with Weis momentum state
if _weisMomBull and not htfBull
    htfBias := "HTF △UP"
if _weisMomBear and not htfBear
    htfBias := "HTF △DN"

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// E) PD LEVELS + PIVOTS + MACRO VERDICT
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[dHighPrev, dLowPrev, dClosePrev] = request.security(syminfo.tickerid, "D",
     [high[1], low[1], close[1]], lookahead=barmerge.lookahead_off)
[dOpenCurr, dHighCurr, dLowCurr] = request.security(syminfo.tickerid, "D",
     [open, high, low], lookahead=barmerge.lookahead_off)

float P  = (dHighPrev + dLowPrev + dClosePrev) / 3.0
float R1 = 2.0 * P - dLowPrev
float S1 = 2.0 * P - dHighPrev
float R2 = P + (dHighPrev - dLowPrev)
float S2 = P - (dHighPrev - dLowPrev)
float R3 = dHighPrev + 2.0 * (P - dLowPrev)
float S3 = dLowPrev  - 2.0 * (dHighPrev - P)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// F) DERIVED STATUS + SYNC + PULLBACK + BIAS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float atrPct   = atrV / close * 100.0
float volScore = atrPct + volRatio * 0.6
int   volaLvl  = volScore >= 3.2 ? 3 : volScore >= 2.4 ? 2 : volScore >= 1.6 ? 1 : 0

bool hardBlock = isAvoid or newsActive or not inTradeSession
bool sessionOK = inTradeSession and not hardBlock
bool canTrade  = sessionOK and volaLvl >= 1
bool aboveVWAP = close > vwapLine

// Confluence override — bypass BA BLOCK when everything aligns
bool _htfSell = _htfBearEff or (not _htfBullEff and not aboveVWAP)
bool _htfBuy  = _htfBullEff or (not _htfBearEff and aboveVWAP)
bool _confOverrideSell = _htfSell and not aboveVWAP and _slopeBear and rsi15 < 45 and rsi1h < 45
bool _confOverrideBuy  = _htfBuy  and aboveVWAP     and _slopeBull and rsi15 > 55 and rsi1h > 55
// Extreme TF bias override (4H > 80% one direction = force through BA BLOCK)
bool _extremeSell = wbp4h < 20
bool _extremeBuy  = wbp4h > 80
bool _confOverride = _confOverrideSell or _confOverrideBuy or _extremeSell or _extremeBuy

// Momentum burst — fast move override
float _momMove = math.abs(close - close[3])
bool _momBurst = _momMove > atrV * 2.0
var int _momBar = na
if _momBurst
    _momBar := bar_index
bool _momActive = not na(_momBar) and (bar_index - _momBar <= 10)
// ── FIB RETRACEMENT STRENGTH ──
// Detect swing high/low using 5m-equivalent pivots (5-bar on 5m, 25-bar on 1m)
int _swingLen = timeframe.in_seconds() <= 60 ? 25 : timeframe.in_seconds() <= 300 ? 5 : 3
float _swHi = ta.pivothigh(high, _swingLen, _swingLen)
float _swLo = ta.pivotlow(low, _swingLen, _swingLen)

var float _lastSwHi = na
var float _lastSwLo = na
if not na(_swHi)
    _lastSwHi := _swHi
if not na(_swLo)
    _lastSwLo := _swLo

float _swRange = nz(_lastSwHi) - nz(_lastSwLo)
float _retracePct = _swRange > 0 ? (close - nz(_lastSwLo)) / _swRange : 0.5

// In downtrend: how much price retraced UP from swing low
// In uptrend: how much price retraced DOWN from swing high
bool _isBearTrend = ema13 < ema34
float _fibRetrace = _isBearTrend ? _retracePct : (1.0 - _retracePct)

string _fibTxt = _fibRetrace <= 0.236 ? "VERY STRONG" :
     _fibRetrace <= 0.382 ? "STRONG" :
     _fibRetrace <= 0.500 ? "BALANCED" :
     _fibRetrace <= 0.618 ? "WEAK" : "EXHAUST"

int _fibGradeAdj = _fibRetrace <= 0.236 ? 2 :
     _fibRetrace <= 0.382 ? 1 :
     _fibRetrace <= 0.500 ? 0 :
     _fibRetrace <= 0.618 ? -1 : -2
     
bool belowEma200 = close < ema200m
bool aboveEma200 = close > ema200m

float dist13       = (close - ema13) / close * 100
string pullbackTxt =
     math.abs(dist13) > 0.8 ? "EXTENDED" :
     math.abs(dist13) < 0.2 ? "PULLBACK" : "HEALTHY"

// CX 360 v3: Late entry detection (declared early, used in labels + state machine)
bool _lateEntry     = rsiMain > 68 and pullbackTxt == "EXTENDED" and atrV > ta.sma(atrV, 20) * 1.3
bool _lateEntrySell = rsiMain < 32 and pullbackTxt == "EXTENDED" and atrV > ta.sma(atrV, 20) * 1.3
bool _isLateChase   = _lateEntry or _lateEntrySell

float s5  = (rsi5  - 50) * 2
float s15 = (rsi15 - 50) * 2
float s1h = (rsi1h - 50) * 2
float s4h = (rsi4h - 50) * 2

int biasAlignScore =
     (s5  > 0 ? 1 : 0) + (s15 > 0 ? 1 : 0) +
     (s1h > 0 ? 1 : 0) + (s4h > 0 ? 1 : 0)

string biasAlignTxt =
     biasAlignScore == 4 ? "4/4 STRONG" :
     biasAlignScore == 3 ? "3/4 WEAK"   :
     biasAlignScore == 2 ? "2/4 MIXED"  : "<=1/4 AVOID"

bool biasIsAvoid = biasAlignScore <= 1
int _scalpBias  = (s5 > 0 ? 1 : 0) + (s15 > 0 ? 1 : 0)
int _intraBias  = (s5 > 0 ? 1 : 0) + (s15 > 0 ? 1 : 0) + (s1h > 0 ? 1 : 0)
bool _scalpBullOK  = tradeStyle == "Scalp" and _scalpBias >= 2
bool _scalpBearOK  = tradeStyle == "Scalp" and _scalpBias == 0
bool _intraBullOK  = tradeStyle == "Intraday" and _intraBias >= 2
bool _intraBearOK  = tradeStyle == "Intraday" and _intraBias <= 1

float ema13dist     = math.abs(close - ema13) / close * 100
float _ema13thresh  = tf_secs <= 60 ? 0.08 : 0.15
bool  ema13touch    = ema13dist < _ema13thresh
bool  ema13pullLong = ema13touch and close >= ema13 and close[1] < ema13
bool  ema13pullShrt = ema13touch and close <= ema13 and close[1] > ema13
bool  rsi5above50   = rsi5 > 50 and rsi5[1] <= 50
bool  rsi5below50   = rsi5 < 50 and rsi5[1] >= 50
bool  momentumFlipUp = rsi5above50 and rsi1h > 50
bool  momentumFlipDn = rsi5below50 and rsi1h < 50
bool  trendBull      = _htfBullEff and biasAlignScore >= 3
bool  trendBear      = _htfBearEff and biasAlignScore <= 1

bool _rawScalpLong = inTradeSession and not hardBlock and trendBull and rsiMain < 75 and s5 > 0 and
     (ema13pullLong or momentumFlipUp or (pullbackTxt == "PULLBACK" and rsiMain > 40 and rsiMain < 55))
bool _rawScalpShort = inTradeSession and not hardBlock and trendBear and rsiMain > 25 and s5 <= 0 and
     (ema13pullShrt or momentumFlipDn or (pullbackTxt == "PULLBACK" and rsiMain > 45 and rsiMain < 60))

var int _lastScalpBar = 0
int  _barsSinceLast = bar_index - _lastScalpBar
int  _cooldownLen   = tf_secs <= 60 ? 25 : 15
bool _cooldownOK    = _barsSinceLast >= _cooldownLen
bool _volOK         = volRatio >= 1.0

bool scalpLong  = _rawScalpLong  and _cooldownOK and _volOK
bool scalpShort = _rawScalpShort and _cooldownOK and _volOK

if (scalpLong and not scalpLong[1]) or (scalpShort and not scalpShort[1])
    _lastScalpBar := bar_index

string sessTxt =
     isUSKill   ? "US KILL"   :
     isLondon   ? "LONDON"    :
     isAsiaCore ? "ASIA CORE" :
     isShanghai ? "SHANGHAI"  :
     isTokyo    ? "TOKYO"     :
     isIndia    ? "INDIA"     : "AVOIDE"

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// H) READINESS SCORE + ZONE ENGINE + CANDLE PATTERNS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float zoneWidth = close * (zone_near_pct / 100.0)
// CX 360 v3: Widen zone detection in strong trends — EMA13 pullback = valid entry zone
float _dynZoneWidth = (_htfBullEff or _htfBearEff) and adxV > 25 ? zoneWidth * 1.5 : zoneWidth

float nearSupport = na
float _dists = 99999.0
float[] supLevels = array.new_float()
if not na(vwapLine)
    array.push(supLevels, vwapLine)
if not na(dLowPrev)
    array.push(supLevels, dLowPrev)
if not na(S1)
    array.push(supLevels, S1)
if not na(S2)
    array.push(supLevels, S2)
if not na(P)
    array.push(supLevels, P)
if not na(ema13)
    array.push(supLevels, ema13)
if not na(ema34)
    array.push(supLevels, ema34)

for i = 0 to array.size(supLevels) - 1
    float lvl = array.get(supLevels, i)
    float d   = math.abs(close - lvl)
    if d < _dists and close >= lvl - _dynZoneWidth
        _dists      := d
        nearSupport := lvl

float nearResist = na
float _distr = 99999.0
float[] resLevels = array.new_float()
if not na(vwapLine)
    array.push(resLevels, vwapLine)
if not na(dHighPrev)
    array.push(resLevels, dHighPrev)
if not na(R1)
    array.push(resLevels, R1)
if not na(R2)
    array.push(resLevels, R2)
if not na(P)
    array.push(resLevels, P)
if not na(ema13)
    array.push(resLevels, ema13)
if not na(ema34)
    array.push(resLevels, ema34)

for i = 0 to array.size(resLevels) - 1
    float lvl = array.get(resLevels, i)
    float d   = math.abs(close - lvl)
    if d < _distr and close <= lvl + _dynZoneWidth
        _distr     := d
        nearResist := lvl

bool atSupport    = not na(nearSupport) and math.abs(close - nearSupport) <= _dynZoneWidth
bool atResistance = not na(nearResist)  and math.abs(close - nearResist)  <= _dynZoneWidth

// ── CONF score (0-100) — replaces ALIGN/syncScore ────────────────
// Measures overall trade confidence from multiple independent factors
// CX 360 v3: Added Weis MTF factor, rebalanced level weight
int _weisMix = int(math.round(wbp4h * 0.35 + wbp1h * 0.28 + wbp15m * 0.22 + wbp5m * 0.15))
int _confScore = 0
if htfBull or htfBear or _weisMomBull or _weisMomBear  // HTF has clear direction (incl Weis override)
    _confScore += 20
if adxV > 20                                      // Trend strength confirmed
    _confScore += 15
if biasAlignScore >= 3                             // MTF RSI bias aligned
    _confScore += 20
if emasTrending                                    // EMAs properly separated
    _confScore += 15
if volRatio > 1.0                                  // Volume above average
    _confScore += 10
if atSupport or atResistance                       // Price at key level
    _confScore += 15                               // v3: reduced from 20 to make room for Weis
// CX 360 v3: Weis MTF alignment — strongest directional signal
bool _weisAlignedBull = _weisMix >= 65 and _htfBullEff
bool _weisAlignedBear = _weisMix <= 35 and _htfBearEff
if _weisAlignedBull or _weisAlignedBear
    _confScore += 15

if adxV < 15
    _confScore := math.min(_confScore, 55)
else if adxV < 20
    _confScore := math.min(_confScore, 70)
// Slope trending but ADX weak → boost CONF (ADX lag compensation)
if _slopeTrending and adxV < 20
    _confScore := math.min(_confScore + 15, 75)
// CX 360 v3: 3-tier session dampening (full / mid / off)
bool _sessOff = not inTradeSession
bool _sessMid = isMidVolSess  // Shanghai solo
if _sessOff
    if adxV > 25
        _confScore := int(_confScore * 0.8)
    else if adxV > 20
        _confScore := int(_confScore * 0.7)
    else
        _confScore := int(_confScore * 0.6)
else if _sessMid
    _confScore := int(_confScore * 0.85)  // mild dampening, not full block
    
float syncScore = math.min(100, float(_confScore)) // keep syncScore alias
float _confSmooth = ta.ema(syncScore, 5)           // ICM 1.4: smoothed CONF
string _confTier = _confSmooth >= 65 ? "HIGH" : _confSmooth >= 40 ? "MED" : "LOW"

bool weisExhaustion = rsiMain < 35 and wbp15m < 20
bool weisOverbought = rsiMain > 65 and wbp15m > 80

// CX 360 v3: Trend-mode RSI windows — wider in confirmed trends
bool _trendModeBuy  = _htfBullEff and adxV > 22
bool _trendModeSell = _htfBearEff and adxV > 22
bool _rsiBuyOK  = _trendModeBuy  ? (rsiMain >= 40 and rsiMain <= 65) : (rsiMain >= 25 and rsiMain <= 45)
bool _rsiSellOK = _trendModeSell ? (rsiMain >= 35 and rsiMain <= 60) : (rsiMain >= 55 and rsiMain <= 75)

int readyBuy =
     (_htfBullEff     ? 1 : 0) +
     (biasAlignScore >= 3 ? 1 : 0) +
     (atSupport      ? 1 : 0) +
     (_rsiBuyOK      ? 1 : 0) +
     (isHighVolSess  ? 1 : 0) +
     (pullbackTxt == "PULLBACK" ? 1 : 0) +
     (volRatio > 1.2 ? 1 : 0) +
     (aboveEma200    ? 1 : 0) +
     (weisExhaustion ? 1 : 0) +
     (adxTrending    ? 1 : 0)

int readySell =
     (_htfBearEff     ? 1 : 0) +
     (biasAlignScore <= 1 ? 1 : 0) +
     (atResistance   ? 1 : 0) +
     (_rsiSellOK     ? 1 : 0) +
     (isHighVolSess  ? 1 : 0) +
     (pullbackTxt == "PULLBACK" ? 1 : 0) +
     (volRatio > 1.2 ? 1 : 0) +
     (belowEma200    ? 1 : 0) +
     (weisOverbought ? 1 : 0) +
     (adxTrending    ? 1 : 0)

int rawReadiness = math.max(readyBuy, readySell)
int readiness    = biasIsAvoid ? math.min(rawReadiness, 5) : rawReadiness

bool   isBuyReady  = readyBuy >= readySell and readyBuy  >= zone_min_ready and (not biasIsAvoid or _confOverrideBuy or _momActive)
bool   isSellReady = readySell > readyBuy  and readySell >= zone_min_ready and (not biasIsAvoid or _confOverrideSell or _momActive)
string readyDir    = isBuyReady ? "BUY" : isSellReady ? "SELL" : "WAIT"

var float _readyStartPrice = close
var string _readyLastDir = "WAIT"
if readyDir != _readyLastDir
    _readyStartPrice := close
    _readyLastDir := readyDir
float _readyPriceMove = close - _readyStartPrice

bool _readyStress = (readyDir == "SELL" and _readyPriceMove > atrV * 2.0) or (readyDir == "BUY" and _readyPriceMove < -atrV * 2.0)
bool _readyCancel = (readyDir == "SELL" and _readyPriceMove > atrV * 3.0) or (readyDir == "BUY" and _readyPriceMove < -atrV * 3.0)

string readyTxt    = str.tostring(readiness) + "/10"
// ICM 1.4: Enhanced READY decision engine
string readyDecision =
     hardBlock                              ? "AVOID"     :
     _confSmooth < 25                       ? "LOW CONF"  :
     _readyCancel                           ? "TRAP"      :
     isSellReady and readiness >= 7         ? "▶ SELL"    :
     isBuyReady  and readiness >= 7         ? "▶ BUY"     :
     isSellReady and readiness >= 5         ? "△ SELL"    :
     isBuyReady  and readiness >= 5         ? "△ BUY"     :
                                              "WAIT"
// ICM 1.4: NEXT confirmation — what's missing for trade
string _nextTxt = "WAIT"
if readyDecision == "▶ SELL" or readyDecision == "▶ BUY"
    _nextTxt := "GO"
else if readyDecision == "AVOID" or readyDecision == "TRAP"
    _nextTxt := "—"
else if not (atSupport or atResistance)
    _nextTxt := "LEVEL"
else if not _htfBullEff and not _htfBearEff
    _nextTxt := "HTF ALIGN"
else if not adxTrending
    _nextTxt := "ADX >20"
else if pullbackTxt != "PULLBACK"
    _nextTxt := "PULLBK"
else if volRatio <= 1.2
    _nextTxt := "VOL"
else if readyDir == "SELL" and aboveVWAP
    _nextTxt := "VWAP BRK"
else if readyDir == "BUY" and not aboveVWAP
    _nextTxt := "VWAP BRK"
string readyDisp   = readyDir + " " + readyTxt

// Trade Score Grade
// Trade Score Grade (with Fib Retracement Strength + session weight + round level)
int _gradeScore = 0
if _confScore >= 80
    _gradeScore := 4
else if _confScore >= 65
    _gradeScore := 3
else if _confScore >= 50
    _gradeScore := 2
else if _confScore >= 35
    _gradeScore := 1

_gradeScore := math.max(0, math.min(5, _gradeScore + _fibGradeAdj))
// Session weight: active session boosts, off session penalizes
if inTradeSession
    _gradeScore := math.min(5, _gradeScore + 1)
else
    _gradeScore := math.max(0, _gradeScore - 1)

// Round number detection (psychological levels: x00, x50)
float _roundMod = close % 100
bool _atRoundLevel = _roundMod < 3 or _roundMod > 97 or (math.abs(_roundMod - 50) < 3)

string _grade = "AVOID"
if _gradeScore >= 4 and inTradeSession and adxV >= 25 and (isBuyReady or isSellReady or _extremeSell or _extremeBuy)
    _grade := "A+"
else if _gradeScore >= 3 and (isBuyReady or isSellReady)
    _grade := "A"
else if _gradeScore >= 2
    _grade := "B"
else if _gradeScore >= 1
    _grade := "C"

// ICM 1.2: Block zones during session OFF
// ICM 1.4: Dynamic zone deactivation — 3/3 lower TFs opposing kills zone
bool _ltfAllBull = rsiMain > 50 and s5 > 0 and s15 > 0
bool _ltfAllBear = rsiMain < 50 and s5 <= 0 and s15 <= 0
bool buyZoneActive  = show_zones and isBuyReady  and atSupport    and not hardBlock and not _sessOff and not _ltfAllBear
bool sellZoneActive = show_zones and isSellReady and atResistance and not hardBlock and not _sessOff and not _ltfAllBull

// ICM 1.4: Suppress scalp arrows when zone active (redundant noise)
if buyZoneActive or sellZoneActive
    scalpLong  := false
    scalpShort := false

// ─────────────────────────────────────────
// ZONE BREAKOUT DETECTION
// ─────────────────────────────────────────

var int _lastSellZoneBar = 0
var int _lastBuyZoneBar  = 0

if sellZoneActive
    _lastSellZoneBar := bar_index

if buyZoneActive
    _lastBuyZoneBar := bar_index

bool _recentSellZone =
     (bar_index - _lastSellZoneBar) <= 5 and
     (bar_index - _lastSellZoneBar) > 0

bool _recentBuyZone =
     (bar_index - _lastBuyZoneBar) <= 5 and
     (bar_index - _lastBuyZoneBar) > 0

bool breakoutUp =
     _recentSellZone and
     not sellZoneActive and
     not na(nearResist) and
     close > nearResist + atrV * 0.5

bool breakoutDn =
     _recentBuyZone and
     not buyZoneActive and
     not na(nearSupport) and
     close < nearSupport - atrV * 0.5

color zoneBuyColor  = color.new(color.rgb(0, 200, 100), zone_transp)
color zoneSellColor = color.new(color.rgb(220, 50, 50), zone_transp)
color zoneBg = buyZoneActive ? zoneBuyColor : sellZoneActive ? zoneSellColor : na
bgcolor(zoneBg)

float candleRange  = high - low
bool  hasExpansion = candleRange >= atrV * atr_expand_pct
bool  patternSessionOK = inTradeSession and not hardBlock
float bodySize   = math.abs(close - open)
float upperWick  = high - math.max(close, open)
float lowerWick  = math.min(close, open) - low
float totalRange = high - low
bool  isBullCandle = close > open
bool  isBearCandle = close < open

bool pattQualityBuy  = buyZoneActive  and emasTrending and hasExpansion and patternSessionOK and tf_pattern_ok and volRatio >= 1.0
bool pattQualitySell = sellZoneActive and emasTrending and hasExpansion and patternSessionOK and tf_pattern_ok and volRatio >= 1.0

bool isHammer       = pattQualityBuy  and lowerWick >= bodySize * 2 and upperWick < bodySize * 0.5 and totalRange > atrV * 0.3
bool isShootingStar = pattQualitySell and upperWick >= bodySize * 2 and lowerWick < bodySize * 0.5 and totalRange > atrV * 0.3
bool isBullEngulf   = pattQualityBuy  and isBullCandle and close[1] < open[1] and
     close > open[1] and open < close[1] and bodySize > math.abs(close[1] - open[1])
bool isBearEngulf   = pattQualitySell and isBearCandle and close[1] > open[1] and
     close < open[1] and open > close[1] and bodySize > math.abs(close[1] - open[1])
bool isBullPin      = pattQualityBuy  and lowerWick >= bodySize * 2.5 and totalRange > atrV * 0.4
bool iBearPin       = pattQualitySell and upperWick >= bodySize * 2.5 and totalRange > atrV * 0.4
bool isInsideBar    = high < high[1] and low > low[1]
bool iIBBreakUp     = pattQualityBuy  and isInsideBar[1] and close > high[1]
bool iIBBreakDn     = pattQualitySell and isInsideBar[1] and close < low[1]

bool bullPattern = isHammer or isBullEngulf or isBullPin or iIBBreakUp
bool bearPattern = isShootingStar or isBearEngulf or iBearPin or iIBBreakDn

plotshape(show_candle_patt and bullPattern, title="Bull Pattern",
     style=shape.diamond, location=location.belowbar,
     color=color.new(color.rgb(0,255,150), 0), size=size.small,
     text="◆", textcolor=color.rgb(0,255,150), display=display.pane)
plotshape(show_candle_patt and bearPattern, title="Bear Pattern",
     style=shape.diamond, location=location.abovebar,
     color=color.new(color.rgb(255,80,80), 0), size=size.small,
     text="◆", textcolor=color.rgb(255,80,80), display=display.pane)

float swingHigh = ta.highest(high, sl_swing_lookback)
float swingLow  = ta.lowest(low,  sl_swing_lookback)

var line slRefLine = na
var label slRefLbl = na
if barstate.islast and show_sl_ref
    if not na(slRefLine)
        line.delete(slRefLine)
    if not na(slRefLbl)
        label.delete(slRefLbl)
    if isSellReady and readiness >= zone_min_ready
        slRefLine := line.new(bar_index - sl_swing_lookback, swingHigh, bar_index + 5, swingHigh,
             color=color.new(color.rgb(255,180,50), 30), width=2, style=line.style_dotted)
        slRefLbl := label.new(bar_index + 5, swingHigh,
             "🛑 SL ref: " + str.tostring(math.round(swingHigh, 2)),
             style=label.style_label_left, textcolor=color.rgb(255,200,50),
             color=color.new(color.rgb(60,30,0), 60), size=slRefSize)
    else if isBuyReady and readiness >= zone_min_ready
        slRefLine := line.new(bar_index - sl_swing_lookback, swingLow, bar_index + 5, swingLow,
             color=color.new(color.rgb(255,180,50), 30), width=2, style=line.style_dotted)
        slRefLbl := label.new(bar_index + 5, swingLow,
             "🛑 SL ref: " + str.tostring(math.round(swingLow, 2)),
             style=label.style_label_left, textcolor=color.rgb(255,200,50),
             color=color.new(color.rgb(60,30,0), 60), size=slRefSize)

