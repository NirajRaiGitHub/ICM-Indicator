        f_del_line(lPDH), lPDH := na, f_del_line(lPDC), lPDC := na, f_del_line(lPDL), lPDL := na
        f_del_label(lbPDH), lbPDH := na, f_del_label(lbPDC), lbPDC := na, f_del_label(lbPDL), lbPDL := na
        if (manual ? showSRManual : isNear(dHighPrev))
