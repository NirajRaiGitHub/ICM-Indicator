// H3) MICRO LIQUIDITY SWEEP ENGINE
// Reuses: ema13 ema34 ema200m atrV adxV _confScore biasIsAvoid inTradeSession
//         hardBlock isBuyReady isSellReady bodySize
//         upperWick lowerWick totalRange — zero new security calls
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float _lqPrevHi = ta.highest(high, liqLookback)[1]
float _lqPrevLo = ta.lowest(low,   liqLookback)[1]

bool _lqMicroBull = close > ema13 and ema13 > ema34 and (ema13 - ema34) / close * 100 > 0.05
bool _lqMicroBear = close < ema13 and ema13 < ema34 and (ema34 - ema13) / close * 100 > 0.05
bool _lqBearDisp  = close < open and bodySize > atrV * 0.55
bool _lqBullDisp  = close > open and bodySize > atrV * 0.55
bool _lqExpansion = totalRange > atrV * liqAtrMult

// ATR-adaptive cooldown: 3× longer when ADX ranging
var int _lqLastBar = na
int _lqCdLen       = adxV < 18 ? liqCooldownBars * 3 : liqCooldownBars
bool _lqCdOK       = na(_lqLastBar) or (bar_index - _lqLastBar > _lqCdLen)

// ICM gate — light filter: session active + not news/avoid + not dead flat
// Sweeps are counter-trend (stop hunts) so CONF/CLUSTER/BA don't gate them
bool _lqGate = inTradeSession and not hardBlock and adxV >= 20

// Buy-side sweep (LQ↓) — trap buyers → bearish
bool _lqBuySide = showLiquiditySweep and _lqCdOK and _lqGate and
     _lqMicroBear and volRatio >= 1.0 and
     high > _lqPrevHi and close < _lqPrevHi and
     upperWick > totalRange * 0.30 and
     (_lqBearDisp or close < ema13) and _lqExpansion

// Sell-side sweep (LQ↑) — trap sellers → bullish
bool _lqSellSide = showLiquiditySweep and _lqCdOK and _lqGate and
     _lqMicroBull and volRatio >= 1.0 and
     low < _lqPrevLo and close > _lqPrevLo and
     lowerWick > totalRange * 0.30 and
     (_lqBullDisp or close > ema13) and _lqExpansion

if _lqBuySide or _lqSellSide
    _lqLastBar := bar_index

// ICM 1.4: Trend-aware LQ labels
bool _lqSellTrend   = _lqBuySide  and _htfBearEff
bool _lqSellCounter = _lqBuySide  and not _htfBearEff
bool _lqBuyTrend    = _lqSellSide and _htfBullEff
bool _lqBuyCounter  = _lqSellSide and not _htfBullEff

plotshape(_lqSellTrend, title="LQ Sell (trend)",
     style=shape.flag, location=location.abovebar,
     color=color.rgb(255,40,40), text="LQ SELL", textcolor=color.white, size=size.small)
plotshape(_lqSellCounter, title="LQ Sell (counter)",
     style=shape.flag, location=location.abovebar,
     color=color.rgb(180,120,40), text="LQ SELL ⚠", textcolor=color.white, size=size.small)
plotshape(_lqBuyTrend, title="LQ Buy (trend)",
     style=shape.flag, location=location.belowbar,
     color=color.rgb(0,220,120), text="LQ BUY", textcolor=color.white, size=size.small)
plotshape(_lqBuyCounter, title="LQ Buy (counter)",
     style=shape.flag, location=location.belowbar,
     color=color.rgb(180,120,40), text="LQ BUY ⚠", textcolor=color.white, size=size.small)

// ICM 1.4: LQ sweep level line + highlight
if _lqBuySide
    _lqLine = line.new(bar_index, high, bar_index + 20, high, color=color.new(color.rgb(255,40,40), 40), width=1, style=line.style_dashed)
    _lqLbl  = label.new(bar_index + 10, high, "⚡ SWEPT " + str.tostring(high, "#.2"), style=label.style_none, textcolor=color.rgb(255,100,100), size=size.small)
if _lqSellSide
    _lqLine = line.new(bar_index, low, bar_index + 20, low, color=color.new(color.rgb(0,220,120), 40), width=1, style=line.style_dashed)
    _lqLbl  = label.new(bar_index + 10, low, "⚡ SWEPT " + str.tostring(low, "#.2"), style=label.style_none, textcolor=color.rgb(0,220,120), size=size.small)

// LQ sweep background flash
bgcolor(_lqBuySide ? color.new(color.rgb(255,40,40), 88) : _lqSellSide ? color.new(color.rgb(0,220,120), 88) : na, title="LQ Sweep BG")

// ── RSI DIVERGENCE ──
float _divRsi = ta.rsi(close, 14)
int _divLen = 20
float _divLo1 = ta.lowest(low, _divLen)
float _divLo2 = ta.lowest(low, _divLen)[_divLen]
float _divRsi1 = ta.lowest(_divRsi, _divLen)
float _divRsi2 = ta.lowest(_divRsi, _divLen)[_divLen]
float _divHi1 = ta.highest(high, _divLen)
float _divHi2 = ta.highest(high, _divLen)[_divLen]
float _divRsiH1 = ta.highest(_divRsi, _divLen)
float _divRsiH2 = ta.highest(_divRsi, _divLen)[_divLen]

bool _rawBullDiv = _divLo1 < _divLo2 and _divRsi1 > _divRsi2 and _divRsi < 40
bool _rawBearDiv = _divHi1 > _divHi2 and _divRsiH1 < _divRsiH2 and _divRsi > 60

// Cooldown — 15 bars between DIV signals
var int _divLastBar = na
bool _divCdOK = na(_divLastBar) or (bar_index - _divLastBar > 15)
bool bullDiv = _rawBullDiv and _divCdOK
bool bearDiv = _rawBearDiv and _divCdOK
if (bullDiv and not bullDiv[1]) or (bearDiv and not bearDiv[1])
    _divLastBar := bar_index

plotshape(false, title="Bull Divergence",
     style=shape.labelup, location=location.belowbar,
     color=color.rgb(0, 200, 100), text="DIV↑", textcolor=color.white, size=size.tiny)
plotshape(false, title="Bear Divergence",
     style=shape.labeldown, location=location.abovebar,
     color=color.rgb(255, 60, 60), text="DIV↓", textcolor=color.white, size=size.tiny)

