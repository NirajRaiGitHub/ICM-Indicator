// ── VP: POC / VAH / VAL LINES (clean, no boxes) ──
var float[] _vpVol = array.new_float(vpBinCount, 0.0)
var float _vpHi = na
var float _vpLo = na
bool _hasVP = not na(volume) and volume > 0

if ta.change(time("D")) != 0
    array.fill(_vpVol, 0.0)
    _vpHi := high
    _vpLo := low
else
    _vpHi := math.max(nz(_vpHi, high), high)
    _vpLo := math.min(nz(_vpLo, low), low)

float _vpStep = _vpHi != _vpLo ? (_vpHi - _vpLo) / vpBinCount : syminfo.mintick
int _vpBin = _vpStep > 0 ? math.min(int((close - nz(_vpLo, close)) / _vpStep), vpBinCount - 1) : 0
if _vpBin >= 0 and _vpBin < vpBinCount and _hasVP
    array.set(_vpVol, _vpBin, array.get(_vpVol, _vpBin) + nz(volume, 0))

int _vpPocIdx = 0
float _vpMax = 0.0
for i = 0 to vpBinCount - 1
    float v = array.get(_vpVol, i)
    if v > _vpMax
        _vpMax := v
        _vpPocIdx := i

float _vpTotal = array.sum(_vpVol)
float _vpTarget = _vpTotal * 0.70
float _vpAccum = array.get(_vpVol, _vpPocIdx)
int _vpUp = _vpPocIdx
int _vpDn = _vpPocIdx
while _vpAccum < _vpTarget and (_vpUp < vpBinCount - 1 or _vpDn > 0)
    float vA = _vpUp < vpBinCount - 1 ? array.get(_vpVol, _vpUp + 1) : 0.0
    float vB = _vpDn > 0 ? array.get(_vpVol, _vpDn - 1) : 0.0
    if vA >= vB and _vpUp < vpBinCount - 1
        _vpUp += 1
        _vpAccum += vA
    else if _vpDn > 0
        _vpDn -= 1
        _vpAccum += vB
    else
        break

float vpPOC = nz(_vpLo) + (_vpPocIdx + 0.5) * _vpStep
float vpVAH = nz(_vpLo) + (_vpUp + 1) * _vpStep
float vpVAL = nz(_vpLo) + _vpDn * _vpStep

bool _vp5m = showVP and _hasVP and tf_secs == 300
plot(_vp5m ? vpPOC : na, "POC", color=color.new(color.rgb(255, 200, 50), 20), linewidth=2, style=plot.style_stepline, display=display.pane)
plot(_vp5m ? vpVAH : na, "VAH", color=color.new(color.rgb(0, 180, 255), 35), linewidth=1, style=plot.style_stepline, display=display.pane)
plot(_vp5m ? vpVAL : na, "VAL", color=color.new(color.rgb(0, 180, 255), 35), linewidth=1, style=plot.style_stepline, display=display.pane)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SETUP CARD — Execution Panel (Entry / SL / TP1-3 / RR / State)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// ── State Machine ──
// CX 360 v3: Late entry blocks TRIGGER when chasing (_lateEntry defined in section F)

bool _isBuySetup  = buyZoneActive  and (_grade == "A+" or _grade == "A") and syncScore >= 70 and not _lateEntry
bool _isSellSetup = sellZoneActive and (_grade == "A+" or _grade == "A") and syncScore >= 70 and not _lateEntrySell
bool _isReady     = (buyZoneActive or sellZoneActive) and (_grade == "B" or syncScore < 70)
bool _isExtended  = (_isBuySetup and rsiMain > 75) or (_isSellSetup and rsiMain < 25)

string _state = _isLateChase ? "⚠ LATE" :
     _isExtended ? "EXTENDED" :
     (_isBuySetup or _isSellSetup) ? "TRIGGER" :
     _isReady ? "READY" :
     _sessOff ? "WAIT" :
     (_grade == "C" or _grade == "AVOID") ? "INVALID" : "WAIT"

color _stateCol = _state == "TRIGGER" ? color.rgb(0,200,100) :
     _state == "READY" ? color.rgb(245,205,70) :
     _state == "EXTENDED" ? color.rgb(255,140,0) :
     _state == "⚠ LATE" ? color.rgb(255,40,40) :
     _state == "INVALID" ? color.rgb(255,60,60) : color.rgb(120,125,160)

// ── Direction ──
bool _setupActive = (_isBuySetup or _isSellSetup) and not _isExtended
string _setupDir  = _isBuySetup ? "▲ BUY" : _isSellSetup ? "▼ SELL" : "—"

// ── SL: tighter of structure vs ATR ──
float _swingLo10 = ta.lowest(low, 10)
float _swingHi10 = ta.highest(high, 10)
float _atrStop   = atrV * 1.5

float _slBuy  = math.max(_swingLo10, close - _atrStop)
float _slSell = math.min(_swingHi10, close + _atrStop)

float _entry = close
float _sl    = _isBuySetup ? _slBuy : _isSellSetup ? _slSell : na
float _risk  = _setupActive and not na(_sl) ? math.abs(_entry - _sl) : na

// ── TP: structure-based with R fallback ──
float _tp1 = na, float _tp2 = na, float _tp3 = na

if _setupActive and not na(_risk) and _risk > 0
    _tp1 := _isBuySetup ? _entry + _risk : _entry - _risk

    // Collect structure levels for TP2/TP3
    var array<float> _tgt = array.new_float()
    array.clear(_tgt)

    float _lo = _isBuySetup ? _entry + _risk * 0.8 : _entry - _risk * 4.0
    float _hi = _isBuySetup ? _entry + _risk * 4.0 : _entry - _risk * 0.8

    // Add structural levels in valid range
    for _lvl in array.from(dHighPrev, dLowPrev, P, R1, S1, R2, S2, dHighCurr, dLowCurr)
        if not na(_lvl) and _lvl > math.min(_lo, _hi) and _lvl < math.max(_lo, _hi)
            array.push(_tgt, _lvl)

    if _isBuySetup
        array.sort(_tgt, order.ascending)
    else
        array.sort(_tgt, order.descending)

    _tp2 := array.size(_tgt) >= 1 ? array.get(_tgt, 0) : (_isBuySetup ? _entry + _risk * 2.0 : _entry - _risk * 2.0)
    _tp3 := array.size(_tgt) >= 2 ? array.get(_tgt, 1) : (_isBuySetup ? _entry + _risk * 3.0 : _entry - _risk * 3.0)

    // Ensure TP ordering
    if _isBuySetup
        if _tp2 < _tp1
            _tp2 := _entry + _risk * 2.0
        if _tp3 < _tp2
            _tp3 := _entry + _risk * 3.0
    else
        if _tp2 > _tp1
            _tp2 := _entry - _risk * 2.0
        if _tp3 > _tp2
            _tp3 := _entry - _risk * 3.0

// ── R:R calculation ──
float _rr = not na(_risk) and _risk > 0 and not na(_tp3) ? math.abs(_tp3 - _entry) / _risk : na
string _rrTxt = not na(_rr) ? "1:" + str.tostring(_rr, "#.#") : "—"
string _quality = na(_rr) ? "—" : _rr >= 3.0 ? "HIGH RR" : _rr >= 2.0 ? "MED RR" : "LOW RR"
color _qualCol = _rr >= 3.0 ? color.rgb(0,200,100) : _rr >= 2.0 ? color.rgb(245,205,70) : color.rgb(255,60,60)

// ── Probability: grade-based + adjustments ──
// CX 360 v3: reuse _weisMix from CONF section (no duplicate calc)
int _baseProb = _grade == "A+" ? 85 : _grade == "A" ? 70 : _grade == "B" ? 50 : _grade == "C" ? 30 : 10
int _probAdj = (syncScore >= 80 ? 5 : syncScore < 50 ? -5 : 0) + (_weisMix >= 65 or _weisMix <= 35 ? 5 : _weisMix >= 45 and _weisMix <= 55 ? -5 : 0)
int _prob = math.max(5, math.min(95, _baseProb + _probAdj))
color _probCol = _prob >= 70 ? color.rgb(80,240,130) : _prob >= 50 ? color.rgb(245,205,70) : color.rgb(255,90,90)

// ── Bias direction (always available) ──
string _biasDir = readyDir == "BUY" ? "▲ BUY" : readyDir == "SELL" ? "▼ SELL" : (_weisMix >= 55 ? "▲ BUY" : _weisMix <= 45 ? "▼ SELL" : "— WAIT")
color _biasDirCol = str.contains(_biasDir, "BUY") ? color.rgb(80,240,130) : str.contains(_biasDir, "SELL") ? color.rgb(255,90,90) : color.rgb(150,155,180)
color _biasBg = str.contains(_biasDir, "BUY") ? color.rgb(0,60,30) : str.contains(_biasDir, "SELL") ? color.rgb(60,0,0) : color.rgb(30,32,50)

// ── Setup Card Table (horizontal, top center) ──
var table setupT = table.new(position.top_center, 12, 2, border_width=1)

if barstate.islast and showSetupCard
    color _cardBg = color.rgb(18, 20, 35)
    color _cardBdr = _setupActive ? (_isBuySetup ? color.rgb(0,200,100) : color.rgb(255,60,60)) :
         _state == "READY" ? color.rgb(245,205,70) : color.rgb(50,55,80)
    color _lblTx = color.rgb(120,125,160)
    color _valTx = color.rgb(220,225,245)
    color _gradeTx = _grade == "A+" ? color.rgb(80,240,130) : _grade == "A" ? color.rgb(80,240,130) : _grade == "B" ? color.rgb(245,205,70) : color.rgb(255,90,90)

    // ── Horizontal Setup Card (top center) ──
    // Row 0: Headers
    table.cell(setupT, 0, 0, "BIAS",  text_color=_lblTx, text_size=size.small, bgcolor=color.rgb(28,30,50))
    table.cell(setupT, 1, 0, "STATE", text_color=_lblTx, text_size=size.small, bgcolor=color.rgb(28,30,50))
    table.cell(setupT, 2, 0, "PROB",  text_color=_lblTx, text_size=size.small, bgcolor=color.rgb(28,30,50))
    table.cell(setupT, 3, 0, "GRADE", text_color=_lblTx, text_size=size.small, bgcolor=color.rgb(28,30,50))
    table.cell(setupT, 4, 0, "CONF",  text_color=_lblTx, text_size=size.small, bgcolor=color.rgb(28,30,50))
    table.cell(setupT, 5, 0, "ENTRY", text_color=_lblTx, text_size=size.small, bgcolor=color.rgb(28,30,50))
    table.cell(setupT, 6, 0, "SL",    text_color=_lblTx, text_size=size.small, bgcolor=color.rgb(28,30,50))
    table.cell(setupT, 7, 0, "TP1",   text_color=_lblTx, text_size=size.small, bgcolor=color.rgb(28,30,50))
    table.cell(setupT, 8, 0, "TP2",   text_color=_lblTx, text_size=size.small, bgcolor=color.rgb(28,30,50))
    table.cell(setupT, 9, 0, "TP3",   text_color=_lblTx, text_size=size.small, bgcolor=color.rgb(28,30,50))
    table.cell(setupT, 10, 0, "R:R",  text_color=_lblTx, text_size=size.small, bgcolor=color.rgb(28,30,50))
    table.cell(setupT, 11, 0, "QUAL", text_color=_lblTx, text_size=size.small, bgcolor=color.rgb(28,30,50))

    // Row 1: Values
    table.cell(setupT, 0, 1, _setupActive ? _setupDir + " SETUP" : _biasDir,
         text_color=_setupActive ? (_isBuySetup ? color.rgb(80,240,130) : color.rgb(255,90,90)) : _biasDirCol, text_size=size.normal, bgcolor=_biasBg)
    table.cell(setupT, 1, 1, _state, text_color=_stateCol, text_size=size.normal, bgcolor=_cardBg)
    table.cell(setupT, 2, 1, str.tostring(_prob) + "%", text_color=_probCol, text_size=size.normal, bgcolor=_cardBg)
    table.cell(setupT, 3, 1, _grade, text_color=_gradeTx, text_size=size.normal, bgcolor=_cardBg)
    table.cell(setupT, 4, 1, str.tostring(int(syncScore)) + "%", text_color=syncScore >= 70 ? color.rgb(80,240,130) : color.rgb(245,205,70), text_size=size.normal, bgcolor=_cardBg)

    if _setupActive and not na(_risk) and _risk > 0
        table.cell(setupT, 5, 1, str.tostring(_entry, "#.#"), text_color=_valTx, text_size=size.normal, bgcolor=_cardBg)
        table.cell(setupT, 6, 1, str.tostring(_sl, "#.#"), text_color=color.rgb(255,90,90), text_size=size.normal, bgcolor=_cardBg)
        table.cell(setupT, 7, 1, str.tostring(_tp1, "#.#"), text_color=color.rgb(245,205,70), text_size=size.normal, bgcolor=_cardBg)
        table.cell(setupT, 8, 1, str.tostring(_tp2, "#.#"), text_color=color.rgb(80,240,130), text_size=size.normal, bgcolor=_cardBg)
        table.cell(setupT, 9, 1, str.tostring(_tp3, "#.#"), text_color=color.rgb(0,200,255), text_size=size.normal, bgcolor=_cardBg)
        table.cell(setupT, 10, 1, _rrTxt, text_color=_qualCol, text_size=size.normal, bgcolor=_cardBg)
        table.cell(setupT, 11, 1, _quality, text_color=_qualCol, text_size=size.normal, bgcolor=_cardBg)
    else
        for _ci = 5 to 11
            table.cell(setupT, _ci, 1, "—", text_color=color.rgb(60,65,90), text_size=size.normal, bgcolor=_cardBg)

